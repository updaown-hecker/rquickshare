@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  font-family: 'DM Sans', sans-serif;
  color: #f5f6f8;
  background: #111317;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html, body, #app { width: 100%; height: 100%; margin: 0; overflow: hidden; }
button { border: 0; color: inherit; font: inherit; }
button:focus-visible { outline: 2px solid #c2f36d; outline-offset: 3px; }

.shell {
  --ink: #f5f6f8;
  --muted: #989da8;
  --dim: #626874;
  --line: rgba(255,255,255,.08);
  --panel: #181b21;
  --panel-soft: #1d2027;
  --lime: #c6f36e;
  --lime-dark: #a7d954;
  width: 100%; height: 100%; min-width: 900px;
  background: radial-gradient(circle at 74% 12%, rgba(101,113,58,.09), transparent 28%), #111317;
  letter-spacing: -.01em;
}
.shell.is-dragging { background: radial-gradient(circle at 52% 52%, rgba(198,243,110,.11), transparent 38%), #111317; }
.topbar { height: 78px; padding: 0 34px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
.brand-lockup, .topbar-actions, .connection-pill, .device-chip, .selected-header, .share-next, .transfer-top, .transfer-bottom, .transfer-state, .recent-row, .modal-heading, .setting-row { display: flex; align-items: center; }
.brand-lockup { gap: 13px; }
.brand-mark { width: 28px; height: 28px; position: relative; display: flex; align-items: center; justify-content: center; gap: 3px; transform: rotate(-24deg); }
.brand-mark span { display: block; width: 5px; border-radius: 4px; background: var(--lime); box-shadow: 0 0 18px rgba(198,243,110,.35); }
.brand-mark span:nth-child(1) { height: 12px; opacity: .55; }.brand-mark span:nth-child(2) { height: 22px; }.brand-mark span:nth-child(3) { height: 15px; opacity: .75; }
.eyebrow { font-size: 10px; letter-spacing: .16em; font-weight: 700; color: var(--dim); }
.brand-name { font: 600 17px 'Space Grotesk', sans-serif; letter-spacing: -.03em; }
.topbar-actions { gap: 19px; }.connection-pill { gap: 8px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.025); font-size: 12px; color: #c6cad0; cursor: pointer; }.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 4px rgba(198,243,110,.1); }.live-dot.muted { background: #727783; box-shadow: none; }
.icon-button, .avatar { cursor: pointer; background: transparent; color: var(--muted); }.icon-button { font-size: 23px; padding: 4px; }.avatar { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg, #394143, #22262a); color: var(--lime); font-size: 12px; font-weight: 700; }
.workspace { display: flex; height: calc(100% - 78px); }.rail { width: 175px; padding: 29px 18px 20px; display: flex; flex-direction: column; border-right: 1px solid var(--line); }.rail-item { width: 100%; height: 44px; margin-bottom: 7px; display: flex; gap: 12px; align-items: center; padding: 0 14px; border-radius: 10px; background: transparent; color: #858b96; text-align: left; font-size: 13px; cursor: pointer; transition: .2s ease; }.rail-item:hover { color: var(--ink); background: rgba(255,255,255,.04); }.rail-item.active { color: var(--ink); background: rgba(198,243,110,.09); }.rail-item.active .rail-icon { color: var(--lime); }.rail-icon { width: 18px; color: #747a85; font-size: 19px; }.rail-spacer { flex: 1; }.version { color: #555b65; font-size: 10px; padding: 15px; letter-spacing: .04em; }
.content-panel { width: min(1020px, calc(100% - 175px)); overflow: auto; padding: 47px 65px 54px; }.content-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 30px; }.content-header h1 { max-width: 610px; margin: 9px 0 7px; font: 600 32px/1.15 'Space Grotesk', sans-serif; letter-spacing: -.045em; }.content-header p { margin: 0; color: var(--muted); font-size: 14px; }.device-chip { gap: 11px; padding: 9px 14px 9px 9px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,.02); min-width: 178px; }.chip-icon { width: 29px; height: 29px; display: grid; place-items: center; border-radius: 8px; color: var(--lime); background: rgba(198,243,110,.1); }.device-chip small, .device-chip strong { display: block; }.device-chip small { font-size: 8px; letter-spacing: .13em; color: var(--dim); }.device-chip strong { margin-top: 2px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.mode-switcher { display: flex; gap: 24px; margin: 38px 0 17px; border-bottom: 1px solid var(--line); }.mode-switcher button { position: relative; padding: 0 1px 13px; background: none; color: var(--dim); font-size: 13px; cursor: pointer; }.mode-switcher button.selected { color: var(--ink); }.mode-switcher button.selected:after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: 3px; background: var(--lime); }
.hero-card { position: relative; min-height: 295px; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px dashed rgba(198,243,110,.2); border-radius: 15px; background: radial-gradient(circle at 50% 45%, rgba(198,243,110,.075), transparent 34%), linear-gradient(135deg, rgba(255,255,255,.03), rgba(255,255,255,.012)); cursor: pointer; transition: .25s ease; }.hero-card:hover, .hero-card.hovering { border-color: rgba(198,243,110,.65); background-color: rgba(198,243,110,.045); transform: translateY(-1px); }.hero-card h2, .selected-card h2, .receive-card h2, .transfer-card h2, .modal h2 { margin: 13px 0 4px; font: 600 20px 'Space Grotesk', sans-serif; letter-spacing: -.03em; }.hero-card p, .receive-card p { margin: 0; color: var(--muted); font-size: 13px; }.upload-glyph { width: 51px; height: 51px; display: grid; place-items: center; border-radius: 15px; background: rgba(198,243,110,.12); color: var(--lime); font-size: 27px; }.primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 700; transition: .2s ease; }.primary-button { color: #171b17; background: var(--lime); box-shadow: 0 5px 22px rgba(198,243,110,.12); }.primary-button:hover { background: #d5fb83; transform: translateY(-1px); }.secondary-button { color: var(--ink); background: rgba(255,255,255,.07); border: 1px solid var(--line); }.secondary-button:hover { background: rgba(255,255,255,.12); }.hero-card .primary-button { margin-top: 20px; }.hint { margin-top: 16px; display: flex; align-items: center; gap: 7px; color: var(--dim); font-size: 10px; }.hint kbd { padding: 2px 5px; border: 1px solid var(--line); border-radius: 3px; font-size: 9px; }.hero-orbit { position: absolute; border: 1px solid rgba(198,243,110,.08); border-radius: 50%; pointer-events: none; }.orbit-one { width: 255px; height: 255px; }.orbit-two { width: 410px; height: 410px; }.orbit-three { width: 620px; height: 620px; }
.selected-card, .receive-card, .transfer-card { border: 1px solid var(--line); border-radius: 15px; background: var(--panel); }.selected-card { padding: 22px; }.selected-header { justify-content: space-between; }.selected-header h2 { margin-bottom: 0; }.text-button { padding: 3px 0; color: #9da3ad; background: none; font-size: 11px; cursor: pointer; }.text-button:hover { color: var(--ink); }.text-button.danger { color: #ef9c9c; }.file-list { margin: 20px 0 15px; max-height: 165px; overflow: auto; }.file-row { display: flex; align-items: center; gap: 11px; padding: 10px 0; border-top: 1px solid var(--line); }.file-icon, .success-icon { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 7px; background: rgba(255,255,255,.06); color: var(--lime); }.file-info { flex: 1; min-width: 0; }.file-info strong, .file-info span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.file-info strong { font-size: 12px; font-weight: 500; }.file-info span { color: var(--dim); font-size: 10px; margin-top: 2px; }.file-check { color: var(--lime); font-size: 15px; }.share-next { gap: 8px; padding-top: 14px; color: var(--muted); font-size: 12px; }.pulse-ring { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 5px rgba(198,243,110,.1); }.scan-count { margin-left: auto; color: var(--lime); font-size: 11px; }
.receive-card { min-height: 190px; padding: 31px; display: flex; align-items: center; gap: 24px; background: radial-gradient(circle at 16% 50%, rgba(198,243,110,.08), transparent 35%), var(--panel); }.receive-radar { position: relative; width: 100px; height: 100px; display: grid; place-items: center; flex: 0 0 auto; }.receive-radar div { z-index: 2; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--lime); color: #222b1c; font-size: 19px; }.receive-radar span { position: absolute; inset: 14px; border: 1px solid rgba(198,243,110,.42); border-radius: 50%; animation: radar 3s infinite ease-out; }.receive-radar span:nth-child(2) { inset: 1px; animation-delay: 1s; }.receive-radar span:nth-child(3) { inset: -13px; animation-delay: 2s; }.receive-card .secondary-button { margin-left: auto; }.receive-card h2 { margin-top: 7px; }
.device-section, .recent-section { margin-top: 26px; }.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 11px; color: var(--dim); font-size: 10px; font-weight: 700; letter-spacing: .14em; }.section-heading small { color: var(--dim); font-size: 10px; letter-spacing: 0; font-weight: 400; }.device-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }.nearby-device { min-width: 0; display: flex; align-items: center; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,.025); text-align: left; cursor: pointer; transition: .2s ease; }.nearby-device:hover { border-color: rgba(198,243,110,.45); background: rgba(198,243,110,.06); }.device-glyph { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 8px; color: var(--lime); background: rgba(198,243,110,.1); font-size: 16px; }.nearby-device strong, .nearby-device small { display: block; }.nearby-device strong { font-size: 12px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.nearby-device small { margin-top: 3px; color: var(--dim); font-size: 10px; }.device-arrow { margin-left: auto; color: var(--lime); font-size: 17px; }
.transfer-card { padding: 22px; margin-top: 5px; }.transfer-top { justify-content: space-between; }.transfer-state { gap: 12px; }.transfer-state h2 { margin-top: 6px; }.transfer-spinner { width: 31px; height: 31px; border: 2px solid rgba(198,243,110,.2); border-top-color: var(--lime); border-radius: 50%; animation: spin 1s linear infinite; }.progress-number { color: var(--lime); font: 600 20px 'Space Grotesk', sans-serif; }.progress-track { height: 5px; overflow: hidden; margin: 22px 0 11px; border-radius: 5px; background: rgba(255,255,255,.08); }.progress-fill { height: 100%; border-radius: inherit; background: var(--lime); transition: width .35s ease; }.transfer-bottom { justify-content: space-between; color: var(--muted); font-size: 10px; }.consent-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 19px; }
.recent-row { gap: 10px; padding: 12px 0; border-top: 1px solid var(--line); }.recent-row > div:nth-child(2) { flex: 1; min-width: 0; }.recent-row strong, .recent-row span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.recent-row strong { font-size: 12px; font-weight: 500; }.recent-row span { margin-top: 3px; color: var(--dim); font-size: 10px; }.recent-row > small { color: var(--lime); font-size: 10px; }.success-icon { background: rgba(198,243,110,.12); }.modal-backdrop { position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; background: rgba(7,8,10,.72); backdrop-filter: blur(9px); }.modal { width: min(420px, calc(100vw - 35px)); padding: 24px; border: 1px solid var(--line); border-radius: 15px; background: #1b1e24; box-shadow: 0 25px 80px rgba(0,0,0,.4); }.modal-heading { justify-content: space-between; margin-bottom: 24px; }.settings-list { border-top: 1px solid var(--line); }.setting-row { width: 100%; justify-content: space-between; gap: 16px; padding: 15px 0; border-bottom: 1px solid var(--line); background: none; text-align: left; cursor: pointer; }.setting-row strong, .setting-row small { display: block; }.setting-row strong { font-size: 12px; font-weight: 500; }.setting-row small { max-width: 285px; margin-top: 4px; overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }.setting-row b { color: var(--lime); font-size: 11px; font-weight: 500; }.modal-footnote { padding-top: 22px; color: var(--dim); font-size: 10px; line-height: 1.6; }.history-list { max-height: 370px; overflow: auto; }.empty-history { padding: 35px 0; color: var(--muted); font-size: 12px; text-align: center; }
@keyframes radar { 0% { transform: scale(.7); opacity: .8; } 80%, 100% { transform: scale(1.25); opacity: 0; } } @keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 1050px) { .content-panel { padding-left: 38px; padding-right: 38px; } .device-chip { display: none; } }

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: dark;
  font-family: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  color: #f5f6f8;
  background: #0e1014;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

* { box-sizing: border-box; }
html, body, #app { width: 100%; height: 100%; margin: 0; overflow: hidden; }
button { border: 0; color: inherit; font: inherit; outline: none; }
button:focus-visible { outline: 2px solid #c2f36d; outline-offset: 3px; }

.shell {
  --ink: #f5f6f8;
  --muted: #9ba1ad;
  --dim: #656b77;
  --line: rgba(255, 255, 255, 0.08);
  --line-strong: rgba(255, 255, 255, 0.14);
  --panel: #16181e;
  --panel-soft: #1c1f27;
  --lime: #c6f36e;
  --lime-glow: rgba(198, 243, 110, 0.22);
  --lime-dark: #9ece4e;
  --danger: #ff6b6b;
  --danger-bg: rgba(255, 107, 107, 0.12);
  width: 100%; height: 100%; min-width: 880px;
  background: radial-gradient(circle at 80% 10%, rgba(198, 243, 110, 0.04) 0%, transparent 40%),
              radial-gradient(circle at 10% 90%, rgba(59, 130, 246, 0.03) 0%, transparent 45%),
              #0e1014;
  letter-spacing: -0.01em;
  display: flex;
  flex-direction: column;
}

.shell.is-dragging {
  background: radial-gradient(circle at 50% 50%, rgba(198, 243, 110, 0.14), transparent 55%), #0e1014;
}

.topbar {
  height: 72px;
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  background: rgba(14, 16, 20, 0.85);
  backdrop-filter: blur(12px);
  z-index: 10;
}

.brand-lockup, .topbar-actions, .connection-pill, .device-chip, .selected-header, .share-next, .transfer-top, .transfer-bottom, .transfer-state, .recent-row, .modal-heading, .setting-row {
  display: flex;
  align-items: center;
}

.brand-lockup { gap: 12px; user-select: none; }
.brand-mark {
  width: 32px;
  height: 32px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.5px;
  transform: rotate(-24deg);
}
.brand-mark span {
  display: block;
  width: 5px;
  border-radius: 4px;
  background: var(--lime);
  box-shadow: 0 0 16px rgba(198, 243, 110, 0.4);
}
.brand-mark span:nth-child(1) { height: 13px; opacity: 0.55; }
.brand-mark span:nth-child(2) { height: 24px; }
.brand-mark span:nth-child(3) { height: 17px; opacity: 0.75; }

.eyebrow {
  font-size: 10px;
  letter-spacing: 0.16em;
  font-weight: 700;
  color: var(--dim);
  text-transform: uppercase;
}
.brand-name {
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.03em;
  color: var(--ink);
}

.topbar-actions { gap: 14px; }

.connection-pill {
  gap: 8px;
  padding: 7px 14px;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.03);
  font-size: 12px;
  font-weight: 500;
  color: #d1d5db;
  cursor: pointer;
  transition: all 0.2s ease;
}
.connection-pill:hover {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(198, 243, 110, 0.3);
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--lime);
  box-shadow: 0 0 0 3px rgba(198, 243, 110, 0.2);
  transition: background 0.2s ease;
}
.live-dot.muted {
  background: #6b7280;
  box-shadow: none;
}

.icon-button, .avatar {
  cursor: pointer;
  background: transparent;
  color: var(--muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  transition: all 0.2s ease;
}
.icon-button {
  width: 36px;
  height: 36px;
  padding: 6px;
}
.icon-button:hover {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.06);
}
.icon-button.active {
  color: var(--lime);
  background: rgba(198, 243, 110, 0.1);
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #2b303a, #1a1d23);
  border: 1px solid var(--line-strong);
  color: var(--lime);
  font-size: 12px;
  font-weight: 700;
}
.avatar:hover {
  border-color: var(--lime);
  transform: scale(1.05);
}

.workspace {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.rail {
  width: 190px;
  padding: 24px 14px 18px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  background: rgba(18, 20, 25, 0.5);
}

.rail-item {
  width: 100%;
  height: 42px;
  margin-bottom: 6px;
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 0 14px;
  border-radius: 10px;
  background: transparent;
  color: #8e95a2;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.rail-item:hover {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.05);
}
.rail-item.active {
  color: #0e1014;
  background: var(--lime);
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(198, 243, 110, 0.2);
}
.rail-item.active .rail-icon {
  color: #0e1014;
}
.rail-icon {
  width: 18px;
  height: 18px;
  color: #798190;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rail-spacer { flex: 1; }

.rail-info {
  padding: 10px 14px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  margin-bottom: 10px;
}
.rail-info-label {
  font-size: 9px;
  color: var(--dim);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}
.rail-info-value {
  font-size: 11px;
  color: var(--muted);
  margin-top: 2px;
  font-family: monospace;
}

.version {
  color: #555b66;
  font-size: 10px;
  padding: 8px 14px;
  letter-spacing: 0.04em;
}

.content-panel {
  flex: 1;
  overflow-y: auto;
  padding: 38px 50px 48px;
  max-width: 1080px;
}

.content-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}
.content-header h1 {
  margin: 8px 0 6px;
  font-weight: 700;
  font-size: 30px;
  line-height: 1.2;
  letter-spacing: -0.04em;
  color: var(--ink);
}
.content-header p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.device-chip {
  gap: 12px;
  padding: 8px 14px 8px 10px;
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.025);
  min-width: 180px;
}
.chip-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: var(--lime);
  background: rgba(198, 243, 110, 0.12);
}
.device-chip small, .device-chip strong { display: block; }
.device-chip small {
  font-size: 9px;
  letter-spacing: 0.12em;
  color: var(--dim);
  text-transform: uppercase;
}
.device-chip strong {
  margin-top: 2px;
  max-width: 130px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 600;
}

.mode-switcher {
  display: flex;
  gap: 28px;
  margin: 32px 0 20px;
  border-bottom: 1px solid var(--line);
}
.mode-switcher button {
  position: relative;
  padding: 0 2px 12px;
  background: none;
  color: var(--dim);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.2s ease;
}
.mode-switcher button:hover {
  color: var(--muted);
}
.mode-switcher button.selected {
  color: var(--ink);
  font-weight: 600;
}
.mode-switcher button.selected::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 2px;
  border-radius: 2px;
  background: var(--lime);
}

.hero-card {
  position: relative;
  min-height: 280px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1.5px dashed rgba(198, 243, 110, 0.25);
  border-radius: 16px;
  background: radial-gradient(circle at 50% 45%, rgba(198, 243, 110, 0.08), transparent 45%),
              linear-gradient(135deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.008));
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.hero-card:hover, .hero-card.hovering {
  border-color: var(--lime);
  background-color: rgba(198, 243, 110, 0.05);
  transform: translateY(-2px);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3), 0 0 24px rgba(198, 243, 110, 0.08);
}
.hero-card h2, .selected-card h2, .receive-card h2, .transfer-card h2, .modal h2 {
  margin: 12px 0 4px;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--ink);
}
.hero-card p, .receive-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.upload-glyph {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: rgba(198, 243, 110, 0.12);
  color: var(--lime);
  transition: transform 0.2s ease;
}
.hero-card:hover .upload-glyph {
  transform: translateY(-3px) scale(1.05);
}

.primary-button, .secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 38px;
  padding: 0 18px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.primary-button {
  color: #0e1014;
  background: var(--lime);
  box-shadow: 0 4px 18px rgba(198, 243, 110, 0.2);
}
.primary-button:hover {
  background: #d4f884;
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(198, 243, 110, 0.3);
}
.secondary-button {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--line-strong);
}
.secondary-button:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}

.hero-card .primary-button { margin-top: 20px; }

.hint {
  margin-top: 14px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--dim);
  font-size: 11px;
}
.hint kbd {
  padding: 2px 6px;
  border: 1px solid var(--line-strong);
  border-radius: 4px;
  font-size: 10px;
  background: rgba(255, 255, 255, 0.04);
}

.hero-orbit {
  position: absolute;
  border: 1px solid rgba(198, 243, 110, 0.06);
  border-radius: 50%;
  pointer-events: none;
}
.orbit-one { width: 240px; height: 240px; }
.orbit-two { width: 400px; height: 400px; }
.orbit-three { width: 600px; height: 600px; }

.selected-card, .receive-card, .transfer-card {
  border: 1px solid var(--line-strong);
  border-radius: 16px;
  background: var(--panel);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
}
.selected-card { padding: 24px; }
.selected-header { justify-content: space-between; }
.selected-header h2 { margin-bottom: 0; }

.text-button {
  padding: 4px 8px;
  color: var(--muted);
  background: none;
  font-size: 12px;
  cursor: pointer;
  border-radius: 6px;
  transition: color 0.15s ease;
}
.text-button:hover { color: var(--ink); background: rgba(255, 255, 255, 0.04); }
.text-button.danger { color: var(--danger); }
.text-button.danger:hover { background: var(--danger-bg); }

.file-list {
  margin: 18px 0 14px;
  max-height: 180px;
  overflow-y: auto;
  border-radius: 8px;
}
.file-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 8px;
  border-top: 1px solid var(--line);
  transition: background 0.15s ease;
}
.file-row:first-child { border-top: none; }
.file-row:hover { background: rgba(255, 255, 255, 0.02); }

.file-icon, .success-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  color: var(--lime);
  flex-shrink: 0;
}
.file-info { flex: 1; min-width: 0; }
.file-info strong, .file-info span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.file-info strong { font-size: 13px; font-weight: 500; color: var(--ink); }
.file-info span { color: var(--dim); font-size: 11px; margin-top: 2px; }
.file-check { color: var(--lime); font-size: 16px; margin-right: 4px; }

.share-next {
  gap: 10px;
  padding-top: 14px;
  color: var(--muted);
  font-size: 12px;
  border-top: 1px solid var(--line);
}
.pulse-ring {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--lime);
  box-shadow: 0 0 0 4px rgba(198, 243, 110, 0.18);
  animation: pulse-ring 2s infinite ease-out;
}
.scan-count {
  margin-left: auto;
  color: var(--lime);
  font-weight: 600;
  font-size: 12px;
}

.receive-card {
  min-height: 180px;
  padding: 30px;
  display: flex;
  align-items: center;
  gap: 28px;
  background: radial-gradient(circle at 18% 50%, rgba(198, 243, 110, 0.09), transparent 45%), var(--panel);
}

.receive-radar {
  position: relative;
  width: 100px;
  height: 100px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
}
.receive-radar div {
  z-index: 2;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--lime);
  color: #0e1014;
  box-shadow: 0 0 20px rgba(198, 243, 110, 0.4);
}
.receive-radar span {
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(198, 243, 110, 0.4);
  border-radius: 50%;
  animation: radar 3s infinite cubic-bezier(0.1, 0.6, 0.4, 1);
}
.receive-radar span:nth-child(2) { inset: 2px; animation-delay: 1s; }
.receive-radar span:nth-child(3) { inset: -10px; animation-delay: 2s; }

.receive-card .secondary-button { margin-left: auto; }

.device-section, .recent-section { margin-top: 28px; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  color: var(--dim);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
}
.section-heading small {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0;
  font-weight: 400;
}

.device-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.nearby-device {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.025);
  text-align: left;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.nearby-device:hover {
  border-color: rgba(198, 243, 110, 0.5);
  background: rgba(198, 243, 110, 0.06);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
}

.device-glyph {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: var(--lime);
  background: rgba(198, 243, 110, 0.12);
  flex-shrink: 0;
}

.nearby-device strong, .nearby-device small { display: block; }
.nearby-device strong {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nearby-device small {
  margin-top: 3px;
  color: var(--dim);
  font-size: 11px;
}
.device-arrow {
  margin-left: auto;
  color: var(--lime);
  font-size: 16px;
  transition: transform 0.2s ease;
}
.nearby-device:hover .device-arrow {
  transform: translateX(3px);
}

.transfer-card {
  padding: 24px;
  margin-top: 8px;
}
.transfer-top { justify-content: space-between; }
.transfer-state { gap: 14px; }
.transfer-state h2 { margin-top: 4px; }

.transfer-spinner {
  width: 32px;
  height: 32px;
  border: 2.5px solid rgba(198, 243, 110, 0.2);
  border-top-color: var(--lime);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.progress-number {
  color: var(--lime);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.progress-track {
  height: 6px;
  overflow: hidden;
  margin: 20px 0 12px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.08);
}
.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #a4e53e, var(--lime));
  box-shadow: 0 0 10px rgba(198, 243, 110, 0.4);
  transition: width 0.25s ease-out;
}

.transfer-bottom {
  justify-content: space-between;
  color: var(--muted);
  font-size: 11px;
}

.speed-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 8px;
  border-radius: 6px;
  background: rgba(198, 243, 110, 0.1);
  color: var(--lime);
  font-size: 11px;
  font-weight: 600;
  font-family: monospace;
}

.pin-code-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  margin-top: 14px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px dashed rgba(198, 243, 110, 0.35);
  border-radius: 8px;
  font-size: 12px;
  color: var(--muted);
}
.pin-code-badge strong {
  font-size: 16px;
  letter-spacing: 0.1em;
  color: var(--lime);
  font-family: monospace;
}

.consent-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.recent-row {
  gap: 12px;
  padding: 12px 0;
  border-top: 1px solid var(--line);
}
.recent-row > div:nth-child(2) { flex: 1; min-width: 0; }
.recent-row strong, .recent-row span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-row strong { font-size: 13px; font-weight: 500; color: var(--ink); }
.recent-row span { margin-top: 3px; color: var(--dim); font-size: 11px; }
.recent-row > small {
  color: var(--lime);
  font-size: 11px;
  font-weight: 600;
}
.success-icon {
  background: rgba(198, 243, 110, 0.12);
  color: var(--lime);
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  background: rgba(10, 12, 16, 0.75);
  backdrop-filter: blur(10px);
  animation: fade-in 0.2s ease-out;
}

.modal {
  width: min(440px, calc(100vw - 32px));
  padding: 26px;
  border: 1px solid var(--line-strong);
  border-radius: 18px;
  background: #181b22;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  animation: scale-in 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-heading {
  justify-content: space-between;
  margin-bottom: 22px;
}

.settings-list { border-top: 1px solid var(--line); }
.setting-row {
  width: 100%;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
  background: none;
  text-align: left;
  cursor: pointer;
}
.setting-row:hover strong {
  color: var(--lime);
}
.setting-row strong, .setting-row small { display: block; }
.setting-row strong {
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
  transition: color 0.15s ease;
}
.setting-row small {
  max-width: 290px;
  margin-top: 4px;
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.setting-row b {
  color: var(--lime);
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}

.modal-footnote {
  padding-top: 20px;
  color: var(--dim);
  font-size: 11px;
  line-height: 1.5;
}

.history-list {
  max-height: 360px;
  overflow-y: auto;
}
.empty-history {
  padding: 40px 0;
  color: var(--muted);
  font-size: 13px;
  text-align: center;
}

/* Toast System */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: none;
}
.toast {
  padding: 10px 16px;
  border-radius: 10px;
  background: #20242e;
  border: 1px solid var(--line-strong);
  color: var(--ink);
  font-size: 12px;
  font-weight: 500;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  gap: 8px;
  animation: toast-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes radar {
  0% { transform: scale(0.6); opacity: 0.8; }
  80%, 100% { transform: scale(1.35); opacity: 0; }
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(198, 243, 110, 0.4); }
  70% { box-shadow: 0 0 0 8px rgba(198, 243, 110, 0); }
  100% { box-shadow: 0 0 0 0 rgba(198, 243, 110, 0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scale-in {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes toast-in {
  from { transform: translateY(12px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@media (max-width: 1050px) {
  .content-panel { padding-left: 32px; padding-right: 32px; }
  .device-chip { display: none; }
}
